{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "landuseplanning-public": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/landuseplanning-public",
            "index": "src/index.html",
            "main": "src/main.ts",
            "tsConfig": "src/tsconfig.app.json",
            "polyfills": "src/polyfills.ts",
            "assets": [
              "src/assets",
              {
                "glob": "**/maplibre-gl.{js,css}",
                "input": "node_modules/maplibre-gl/dist",
                "output": "maplibre-gl"
              },
              {
                "glob": "leaflet.js",
                "input": "node_modules/leaflet/dist",
                "output": "leaflet"
              },
              {
                "glob": "leaflet.css",
                "input": "node_modules/leaflet/dist",
                "output": "leaflet"
              },
              {
                "glob": "*.{js,css}",
                "input": "node_modules/leaflet.markercluster/dist",
                "output": "leaflet-markercluster"
              },
              {
                "glob": "esri-leaflet.js",
                "input": "node_modules/esri-leaflet/dist",
                "output": "esri-leaflet"
              },
              {
                "glob": "esri-leaflet-vector.js",
                "input": "node_modules/esri-leaflet-vector/dist",
                "output": "esri-leaflet-vector"
              },
              {
                "glob": "leaflet.ajax.js",
                "input": "src/assets/js",
                "output": "leaflet-ajax"
              },
              {
                "glob": "shp.min.js",
                "input": "node_modules/shpjs/dist",
                "output": "shpjs"
              },
              {
                "glob": "leaflet.shpfile.js",
                "input": "src/assets/js",
                "output": "leaflet-shpfile"
              },
              "src/favicon.ico",
              "src/robots.txt",
              "src/sitemap.xml",
              "src/sitemap_static.xml",
              {
                "glob": "**/*",
                "input": "node_modules/leaflet/dist/images",
                "output": "/leaflet/images"
              }
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "src/styles.scss"
            ],
            "scripts": [
              "node_modules/jquery/dist/jquery.min.js",
              "node_modules/popper.js/dist/umd/popper.min.js",
              "node_modules/bootstrap/dist/js/bootstrap.min.js",
              "src/assets/js/utils.js"
            ]
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "extractCss": true,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "browserTarget": "landuseplanning-public:build",
            "port": 4300
          },
          "configurations": {
            "production": {
              "browserTarget": "landuseplanning-public:build:production"
            }
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "karmaConfig": "./karma.conf.js",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "src/tsconfig.spec.json",
            "scripts": [
              "node_modules/jquery/dist/jquery.min.js",
              "node_modules/popper.js/dist/umd/popper.min.js",
              "node_modules/bootstrap/dist/js/bootstrap.min.js",
              "src/assets/js/utils.js"
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "src/styles.scss"
            ],
            "assets": [
              "src/assets",
              "src/favicon.ico",
              {
                "glob": "**/*",
                "input": "node_modules/leaflet/dist/images",
                "output": "/assets/images"
              },
              {
                "glob": "leaflet.js",
                "input": "node_modules/leaflet/dist",
                "output": "leaflet"
              },
              {
                "glob": "leaflet.css",
                "input": "node_modules/leaflet/dist",
                "output": "leaflet"
              },
              {
                "glob": "*.{js,css}",
                "input": "node_modules/leaflet.markercluster/dist",
                "output": "leaflet-markercluster"
              },
              {
                "glob": "esri-leaflet.js",
                "input": "node_modules/esri-leaflet/dist",
                "output": "esri-leaflet"
              },
              {
                "glob": "esri-leaflet-vector.js",
                "input": "node_modules/esri-leaflet-vector/dist",
                "output": "esri-leaflet-vector"
              },
              {
                "glob": "shp.min.js",
                "input": "node_modules/shpjs/dist",
                "output": "shpjs"
              },
              {
                "glob": "leaflet.ajax.js",
                "input": "src/assets/js",
                "output": "leaflet-ajax"
              },
              {
                "glob": "leaflet.shpfile.js",
                "input": "src/assets/js",
                "output": "leaflet-shpfile"
              },
              {
                "glob": "**/maplibre-gl.{js,css}",
                "input": "node_modules/maplibre-gl/dist",
                "output": "maplibre-gl"
              },
              {
                "glob": "**/*",
                "input": "node_modules/leaflet/dist/images",
                "output": "/assets/images"
              }
            ]
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": [
              "src/tsconfig.app.json",
              "src/tsconfig.spec.json"
            ],
            "exclude": []
          }
        }
      }
    },
    "landuseplanning-public-e2e": {
      "root": "e2e",
      "sourceRoot": "e2e",
      "projectType": "application",
      "architect": {
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "./protractor.conf.js",
            "devServerTarget": "landuseplanning-public:serve"
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": [
              "e2e/tsconfig.e2e.json"
            ],
            "exclude": []
          }
        }
      }
    }
  },
  "defaultProject": "landuseplanning-public",
  "schematics": {
    "@schematics/angular:component": {
      "prefix": "app"
    },
    "@schematics/angular:directive": {
      "prefix": "app"
    }
  }
}