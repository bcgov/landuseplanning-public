
kind: BuildConfig
apiVersion: build.openshift.io/v1
metadata:
  name: lup-public-prerender-static-pages
  namespace: e8b9ad-tools
  labels:
    name: lup-public-prerender-static-pages
spec:
  output:
    to:
      kind: ImageStreamTag
      name: 'lup-public-prerender-static-pages:latest'
  resources:
    limits:
      cpu: 500m
      memory: 4Gi
    requests:
      cpu: 400m
      memory: 2Gi
  successfulBuildsHistoryLimit: 5
  failedBuildsHistoryLimit: 5
  strategy:
    type: Docker
    dockerStrategy:
      from:
        kind: ImageStreamTag
        name: 'lup-public-compiled:latest'
      env:
        - name: BUILD_LOGLEVEL
          value: '5'
  source:
    type: Dockerfile
    dockerfile: |-
      WORKDIR /opt/app-root/src

      COPY --from=image-registry.openshift-image-registry.svc:5000/e8b9ad-tools/lup-public-compiled:latest /opt/app-root/src/dist/landuseplanning-public ./dist/landuseplanning-public
      COPY --from=image-registry.openshift-image-registry.svc:5000/e8b9ad-tools/lup-public-compiled:latest /opt/app-root/src/package*.json ./
      COPY --from=image-registry.openshift-image-registry.svc:5000/e8b9ad-tools/lup-public-compiled:latest /opt/app-root/src/scully.landuseplanning-public.config.ts ./scully.landuseplanning-public.config.ts

      RUN npm ci --only=production && \
          npx scully --config scully.landuseplanning-public.config.ts && \
          mkdir -p /opt/app-root/scully && \
          cp -r dist/scully/* /opt/app-root/scully/
